use Test;

use lib 'lib';
use Numbers;

plan 5;

subtest 'sum_of_first_n_ite', {
  plan 2;
  is(sum_of_first_n_ite(0), 0, 'sum_of_first_n_ite 1');
  is(sum_of_first_n_ite(3), 6, 'sum_of_first_n_ite 2');
};

subtest 'factorial_ite', {
  plan 2;
  is(factorial_ite(0), 1, 'factorial_ite 1');
  is(factorial_ite(4), 24, 'factorial_ite 2');
};

subtest 'fibonacci_ite', {
  plan 3;
  is(fibonacci_ite(0), 0, 'fibonacci_ite 1');
  is(fibonacci_ite(1), 1, 'fibonacci_ite 2');
  is(fibonacci_ite(6), 8, 'fibonacci_ite 3');
};

subtest 'greatest_common_divisor_ite', {
  plan 2;
  is(greatest_common_divisor_ite(12, 8), 4, 'greatest_common_divisor_ite 1');
  is(greatest_common_divisor_ite(7, 5), 1, 'greatest_common_divisor_ite 2');
};

subtest 'least_common_multiple_ite', {
  plan 2;
  is(least_common_multiple_ite(4, 6), 12, 'least_common_multiple_ite 1');
  is(least_common_multiple_ite(6, 8), 24, 'least_common_multiple_ite 2');
};
